# ==============================================================================
# FireSphere.ai — Local Development Environment Configuration (.env.example)
# Role: Member 3 (Database, Infrastructure & DevOps)
# INSTRUCTIONS: Copy this file to .env and adjust variables as needed for local dev.
# DO NOT COMMIT REAL SECRETS, PRODUCTION CREDENTIALS, OR LIVE API KEYS TO GIT.
# ==============================================================================

# ------------------------------------------------------------------------------
# PostgreSQL 16 + PostGIS 3.4 Configuration
# ------------------------------------------------------------------------------
POSTGRES_DB=firesphere
POSTGRES_USER=firesphere_admin
POSTGRES_PASSWORD=postgres_dev_password_change_me
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_EXTERNAL_PORT=5432

# Flyway Migration Configuration
FLYWAY_SCHEMAS=firesphere
FLYWAY_DEFAULT_SCHEMA=firesphere
FLYWAY_USER=firesphere_admin
FLYWAY_PASSWORD=postgres_dev_password_change_me
FLYWAY_URL=jdbc:postgresql://postgres:5432/firesphere

# ------------------------------------------------------------------------------
# Redis 7 Configuration (Caching, Rate Limiting, Temporary Coordination)
# ------------------------------------------------------------------------------
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_EXTERNAL_PORT=6379
REDIS_PASSWORD=redis_dev_password_change_me

# ------------------------------------------------------------------------------
# MinIO S3-Compatible Object Storage Configuration (Local Development)
# (In production, this maps to AWS S3 or Enterprise S3 Storage)
# ------------------------------------------------------------------------------
MINIO_HOST=minio
MINIO_PORT=9000
MINIO_CONSOLE_PORT=9001
MINIO_EXTERNAL_PORT=9000
MINIO_EXTERNAL_CONSOLE_PORT=9001
MINIO_ROOT_USER=minio_dev_admin
MINIO_ROOT_PASSWORD=minio_dev_password_change_me
MINIO_DEFAULT_BUCKETS=firesphere-documents,firesphere-photos,firesphere-evidence,firesphere-backups

# S3 Client Configuration (for Backend & AI Services)
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_ACCESS_KEY=minio_dev_admin
S3_SECRET_KEY=minio_dev_password_change_me
S3_USE_SSL=false

# ------------------------------------------------------------------------------
# Database Encryption Master Key (pgcrypto)
# Runtime environment variable injected into session context for column encryption
# ------------------------------------------------------------------------------
DB_ENCRYPTION_MASTER_KEY=firesphere_local_dev_master_key_32chars!
