{
  "expo": {
    "name": "FireSphere",
    "slug": "firesphere",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "scheme": "firesphere",
    "ios": { "supportsTablet": true, "bundleIdentifier": "com.organization.firesphere" },
    "android": {
      "package": "com.organization.firesphere",
      "versionCode": 1,
      "permissions": ["CAMERA", "ACCESS_COARSE_LOCATION", "ACCESS_FINE_LOCATION", "POST_NOTIFICATIONS"],
      "adaptiveIcon": { "backgroundColor": "#17242d" }
    },
    "plugins": [
      ["expo-font", { "fonts": [
        "../node_modules/@expo-google-fonts/space-grotesk/400Regular/SpaceGrotesk_400Regular.ttf",
        "../node_modules/@expo-google-fonts/space-grotesk/500Medium/SpaceGrotesk_500Medium.ttf",
        "../node_modules/@expo-google-fonts/space-grotesk/600SemiBold/SpaceGrotesk_600SemiBold.ttf",
        "../node_modules/@expo-google-fonts/space-grotesk/700Bold/SpaceGrotesk_700Bold.ttf",
        "../node_modules/@expo-google-fonts/public-sans/400Regular/PublicSans_400Regular.ttf",
        "../node_modules/@expo-google-fonts/public-sans/500Medium/PublicSans_500Medium.ttf",
        "../node_modules/@expo-google-fonts/public-sans/600SemiBold/PublicSans_600SemiBold.ttf",
        "../node_modules/@expo-google-fonts/public-sans/700Bold/PublicSans_700Bold.ttf",
        "../node_modules/@expo/vector-icons/build/vendor/react-native-vector-icons/Fonts/MaterialIcons.ttf"
      ] }],
      ["expo-secure-store", { "configureAndroidBackup": true }],
      ["expo-image-picker", { "photosPermission": "Allow FireSphere to attach evidence to your service request.", "cameraPermission": "Allow FireSphere to capture inspection evidence.", "microphonePermission": false }],
      ["expo-location", { "locationWhenInUsePermission": "Allow FireSphere to record your location for an inspection or service request." }],
      ["expo-sqlite", { "useSQLCipher": true }],
      "expo-notifications"
    ]
  }
}
