def test_evidence_validation_rejects_foreign_model_evidence_id():
    """Security check: Rejects model-generated observation referencing unknown/foreign evidence ID."""
    validator = EvidenceValidator()
    authorized = {"11111111-1111-1111-1111-111111111111", "22222222-2222-2222-2222-222222222222"}

    # Foreign ID not in authorized set
    is_valid, err = validator.validate_provider_evidence_reference(
        observation_evidence_id="99999999-9999-9999-9999-999999999999",
        authorized_evidence_ids=authorized,
    )
    assert is_valid is False
    assert "unauthorized evidence identifier" in err

    # Valid ID in set
    is_valid_ok, err_ok = validator.validate_provider_evidence_reference(
        observation_evidence_id="11111111-1111-1111-1111-111111111111",
        authorized_evidence_ids=authorized,
    )
    assert is_valid_ok is True
    assert err_ok is None


def test_evidence_validation_bounding_box_geometry():
    """Validates bounding box coordinate validation logic."""
    validator = EvidenceValidator()

    # Valid normalized box
    valid_box = BoundingBox(xMin=0.1, yMin=0.2, xMax=0.5, yMax=0.8)
    ok, err = validator.validate_bounding_box(valid_box)
    assert ok is True
    assert err is None

    # Inverted X
    inv_x = BoundingBox(xMin=0.6, yMin=0.2, xMax=0.5, yMax=0.8)
    ok_inv, err_inv = validator.validate_bounding_box(inv_x)
    assert ok_inv is False
    assert "xMin (0.6) must be strictly less than xMax (0.5)" in err_inv

    # Zero area
    zero_box = BoundingBox(xMin=0.2, yMin=0.2, xMax=0.2, yMax=0.5)
    ok_zero, err_zero = validator.validate_bounding_box(zero_box)
    assert ok_zero is False


def test_evidence_validation_image_dimensions():
    """Validates image dimensions boundaries."""
    validator = EvidenceValidator()

    ok, _ = validator.validate_image_dimensions(1920, 1080)
    assert ok is True

    ok_low, err_low = validator.validate_image_dimensions(5, 5)
    assert ok_low is False
    assert "below minimum" in err_low

    ok_huge, err_huge = validator.validate_image_dimensions(20000, 20000)
    assert ok_huge is False
    assert "exceed maximum" in err_huge


