def test_report_generation_records_model_disagreements():
    """Verifies that report generator flags model disagreements as unresolved items."""
    generator = DeterministicReportGenerator()
    insp_id = uuid.uuid4()
    run_id = uuid.uuid4()
    ev_id = uuid.uuid4()

    finding = Finding(
        findingId=uuid.uuid4(),
        evidenceId=ev_id,
        findingType="FIRE_EXTINGUISHER_MISSING",
        confidence=0.88,
        severity=FindingSeverity.HIGH,
        explanation="Conflict between models.",
        model="ensemble",
        modelVersion="1.0",
        reconciliationStatus="CONFLICT",
        conflictType="CATEGORY_MISMATCH",
        conflictDetails={
            "description": "Gemini flagged missing extinguisher; CV flagged obstacle.",
        },
    )

    draft = generator.generate_draft(
        inspection_id=insp_id,
        run_id=run_id,
        findings=[finding],
        evidence_ids=[ev_id],
    )

    assert draft.status.value == "DRAFT"
    assert draft.reviewState.value == "DRAFT"
    assert len(draft.findings) == 1

    # Check that model disagreement is highlighted in unresolved items
    disagreement_items = [u for u in draft.unresolvedItems if "MODEL_DISAGREEMENT" in u.category]
    assert len(disagreement_items) >= 1
    assert "discrepancy" in disagreement_items[0].description.lower()


