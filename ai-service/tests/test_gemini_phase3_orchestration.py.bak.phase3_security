def test_reconciliation_case_1_full_agreement():
    """Case 1: Both Gemini and CV detect similar defect at same location."""
    reconciler = ResultReconciler()
    ev_id = uuid.uuid4()
    insp_id = uuid.uuid4()

    gemini_res = GeminiAnalysisResult(
        evidenceId=str(ev_id),
        model="gemini-2.5-flash",
        status=GeminiAnalysisStatus.ANALYSIS_COMPLETED_WITH_OBSERVATIONS,
        observations=[
            GeminiObservation(
                imageReference=str(ev_id),
                objectCategory="FIRE_EXTINGUISHER",
                potentialHazardCategory="FIRE_EXTINGUISHER_MISSING",
                observationDescription="Extinguisher bracket is vacant.",
                boundingBox=BoundingBox(xMin=0.2, yMin=0.2, xMax=0.4, yMax=0.6),
                confidence=0.91,
                potentialHazardSeverity="HIGH",
            )
        ],
    )

    class MockCVDet:
        className = "FIRE_EXTINGUISHER_MISSING"
        confidence = 0.88
        boundingBox = {"xMin": 0.22, "yMin": 0.19, "xMax": 0.41, "yMax": 0.58}

    findings, status, conflict = reconciler.reconcile(
        evidence_id=ev_id,
        inspection_id=insp_id,
        gemini_result=gemini_res,
        cv_detections=[MockCVDet()],
        cv_status="SUCCESS",
        cv_model_info={"model": "cv-model", "version": "1.0"},
        gemini_model_info={"model": "gemini-2.5-flash"},
    )

    assert status == ReconciliationStatus.AGREEMENT
    assert len(findings) == 1
    f = findings[0]
    assert f.reconciliationStatus == "AGREEMENT"
    assert f.conflictType == "NONE"
    assert len(f.provenance) == 2
    assert f.provenance[0]["providerName"] == "google-gemini"
    assert f.provenance[1]["providerName"] == "firesphere-cv-baseline"
    assert "both identified" in f.explanation


