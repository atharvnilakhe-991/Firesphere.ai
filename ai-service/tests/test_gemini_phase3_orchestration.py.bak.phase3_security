        "officerId": "OFFICER-771",
        "officerRole": "FIRE_OFFICER",
        "remarks": "On-site verification completed: hazard confirmed.",
        "expectedVersion": 1,
    }

    response = test_client.post(
        f"/internal/ai/inspection-analysis/{insp_id}/verify-finding",
