def test_officer_verification_authorized_flow(fresh_repo):
    """Verifies that an authorized Fire Officer can confirm a hazard with audit history."""
    service = OfficerVerificationService(repository=fresh_repo)
    fid = uuid.uuid4()

    # Create initial finding in repository
    finding = Finding(
        findingId=fid,
        evidenceId=uuid.uuid4(),
        findingType="FIRE_EXTINGUISHER_MISSING",
        confidence=0.90,
        severity=FindingSeverity.HIGH,
        explanation="Extinguisher absent at pillar 4.",
        model="ensemble",
        modelVersion="1.0",
        version=1,
    )
    fresh_repo.save_finding(finding)

    req = OfficerFindingVerificationRequest(
        findingId=fid,
        evidenceReviewed=True,
        assessment=OfficerAssessmentType.CONFIRMED_HAZARD,
        officerId="OFFICER-4412",
        officerRole="FIRE_OFFICER",
        remarks="Inspected pillar 4; wall bracket is decommissioned and empty.",
        expectedVersion=1,
    )

    resp = service.verify_finding(req, auth_verified=True)

    assert resp.findingId == fid
    assert resp.verificationStatus == "OFFICER_CONFIRMED"
    assert resp.evidenceReviewed is True
    assert resp.version == 2
    assert len(resp.updatedFinding.auditHistory) == 1

    audit = resp.auditEntry
    assert audit["officerId"] == "OFFICER-4412"
    assert audit["action"] == "OFFICER_FINDING_VERIFICATION"
    assert audit["newAssessment"] == "CONFIRMED_HAZARD"
    assert audit["newEvidenceReviewed"] is True


