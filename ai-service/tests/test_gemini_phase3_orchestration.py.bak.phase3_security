def test_http_verify_finding_rbac_rejection(test_client):
    """Verifies that an unauthorized role is rejected with HTTP 403 Forbidden."""
    insp_id = str(uuid.uuid4())
    find_id = str(uuid.uuid4())

    payload = {
        "findingId": find_id,
        "evidenceReviewed": True,
        "assessment": "CONFIRMED_HAZARD",
        "officerId": "CITIZEN-USER",
        "officerRole": "CITIZEN",
    }

    response = test_client.post(
        f"/internal/ai/inspection-analysis/{insp_id}/verify-finding",
        json=payload,
    )
    assert response.status_code == 403
    data = response.json()
    msg = data.get("message") or (data.get("detail", {}).get("message") if isinstance(data.get("detail"), dict) else data.get("detail", ""))
    assert "not authorized" in str(msg).lower()
