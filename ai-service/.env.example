# ==============================================================================
# FireSphere.ai AI Service Configuration Template
# Copy this file to .env and configure values for local environment.
# DO NOT commit real secrets or production credentials to version control.
# ==============================================================================

AI_SERVICE_NAME=firesphere-ai-service
AI_SERVICE_ENV=development
AI_HOST=0.0.0.0
AI_PORT=8000
AI_LOG_LEVEL=INFO

# Phase 6 Service-to-Service Authentication
AI_SERVICE_AUTH_TOKEN=dev-secret-token-change-in-production
AI_AUTH_ENABLED=false

# Phase 6 Redis Async Queue Configuration
REDIS_URL=redis://localhost:6379/0

# Phase 6 S3 / MinIO Object Storage
S3_ENDPOINT=http://localhost:9000
S3_ACCESS_KEY=dev_admin_access
S3_SECRET_KEY=dev_admin_secret_key_change_in_prod
S3_BUCKET=firesphere-evidence
S3_REGION=us-east-1
S3_SECURE=false

# Phase 6 Execution Timeouts (Seconds)
AI_JOB_TIMEOUT_SECONDS=300
AI_INFERENCE_TIMEOUT_SECONDS=30
AI_EVIDENCE_TIMEOUT_SECONDS=15
AI_HTTP_TIMEOUT_SECONDS=30

# Phase 6 Bounded Retries & Worker Concurrency
AI_MAX_RETRIES=3
AI_WORKER_CONCURRENCY=2

# Phase 6 Model Warmup & Hardware Fallback
AI_MODEL_WARMUP=false
AI_GPU_FALLBACK_TO_CPU=true

# Model Configuration (Phase 3 CV Model Integration)
AI_MODEL_NAME=firesphere-inspection-cv
AI_MODEL_VERSION=0.3.0-phase3
AI_CONFIDENCE_THRESHOLD=0.50
AI_NMS_IOU_THRESHOLD=0.45
AI_MODEL_WEIGHTS_PATH=
AI_INFERENCE_DEVICE=auto

# Computer Vision Preprocessing (Phase 2)
AI_MAX_IMAGE_SIZE_BYTES=20971520
AI_TARGET_IMAGE_WIDTH=640
AI_TARGET_IMAGE_HEIGHT=640
AI_MIN_IMAGE_WIDTH=64
AI_MIN_IMAGE_HEIGHT=64
AI_IMAGE_COLOR_FORMAT=RGB
AI_BLUR_THRESHOLD=30.0
AI_ENABLE_NORMALIZATION=true
AI_ENABLE_MOCK_EVIDENCE_LOADER=true

# Gemini VLM Integration (Phase 1)
# Gemini is disabled by default to maintain fail-closed operations without external credentials.
GEMINI_ENABLED=false
# Google Gemini API key (Required if GEMINI_ENABLED=true; never commit real keys)
GEMINI_API_KEY=
# Configured Gemini model ID (Must support image understanding and structured output)
GEMINI_MODEL=gemini-2.5-flash
# Timeout in seconds for Gemini API requests
GEMINI_TIMEOUT_SECONDS=30
# Maximum bounded retry attempts for transient API errors
GEMINI_MAX_RETRIES=3

